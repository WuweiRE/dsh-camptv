  "files": [
    "index.js",
    "tools.snapshot.json",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "README.zh.md"
  ],
  "license": "MIT",
  "author": "WuweiRE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WuweiRE/dsh-camptv.git"
  },
